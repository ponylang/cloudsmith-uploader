use "pony_test"
use "../cloudsmith-uploader"

actor \nodoc\ Main is TestList
  new create(env: Env) => PonyTest(env, this)
  new make() => None

  fun tag tests(test: PonyTest) =>
    test(_TestBuildSlotRequestBody)
    test(_TestParseSlotResponseOK)
    test(_TestParseSlotResponseMissingFields)
    test(_TestParseSlotResponseInvalidJSON)
    test(_TestBuildCompletionBody)
    test(_TestBuildPackageCreateBody)
    test(_TestParsePackageCreateResponse)
    test(_TestParsePackageCreateResponseMissing)
    test(_TestParseSyncStatusCompleted)
    test(_TestParseSyncStatusFailed)
    test(_TestParseSyncStatusInProgress)
    test(_TestParseSyncStatusNoProgress)
    test(_TestParseSyncStatusBothTrue)
    test(_TestParseSyncStatusInvalidJSON)
    test(_TestParsePackageCreateInvalidJSON)
    test(_TestParseSyncStatusMissingFields)
    test(_TestParseSyncStatusWrongType)
    test(_TestParseUploadURLHTTPS)
    test(_TestParseUploadURLWithPort)
    test(_TestParseUploadURLPortAndQuery)
    test(_TestParseUploadURLEmptyPath)
    test(_TestParseUploadURLHTTP)
    test(_TestParseUploadURLNoScheme)
    test(_TestParseUploadURLInvalid)
    test(_TestRetryPolicyIsRetryable429)
    test(_TestRetryPolicyIsRetryable500)
    test(_TestRetryPolicyIsRetryable502)
    test(_TestRetryPolicyIsRetryable503)
    test(_TestRetryPolicyIsRetryable504)
    test(_TestRetryPolicyNotRetryable200)
    test(_TestRetryPolicyNotRetryable400)
    test(_TestRetryPolicyNotRetryable404)
    test(_TestRetryPolicyNotRetryable501)
    test(_TestRetryPolicyDelay)
    test(_TestEnvVarFound)
    test(_TestEnvVarNotFound)
    test(_TestEnvVarEmptyValue)
    test(_TestEnvVarPrefixMatch)
    test(_TestEnvVarEqualsInValue)
    test(_TestEnvVarEmptyVars)
